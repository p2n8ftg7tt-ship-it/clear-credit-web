{"nodes": [{"id": "specs_007_themora_digital_score_spec", "label": "Spec 007: Themora Digital Score on Aparezco", "file_type": "document", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_007_themora_digital_score_spec_themora_digital_score", "label": "Themora Digital Score (TDS) - Indice de Salud Digital", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the simple percent-of-checks score with a named, explained five-pillar index so owners see where they are weak."}, {"id": "specs_007_themora_digital_score_spec_aparezco_page", "label": "Aparezco page (aparezco.html)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_007_themora_digital_score_spec_revisar_negocio_function", "label": "revisar-negocio Netlify function", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_007_themora_digital_score_spec_pilar_reputacion", "label": "Reputacion pillar (30%)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "60% adjusted rating + 40% log volume score; prevents 5.0 from 1 review looking excellent."}, {"id": "specs_007_themora_digital_score_spec_pilar_visibilidad", "label": "Visibilidad pillar (25%)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rule B: top 3=100, 4-10 minus 15 per position, name-only=30, not found=0; departs from the .py 0.3 multiplier."}, {"id": "specs_007_themora_digital_score_spec_pilar_fundamentos", "label": "Fundamentos pillar (20%)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Average of website linked and full hours; claim status is unobservable so not counted as 0."}, {"id": "specs_007_themora_digital_score_spec_pilar_completitud", "label": "Completitud pillar (15%)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100*(1-e^(-0.05*photos)); a photo count at the source cap (10) gets full credit."}, {"id": "specs_007_themora_digital_score_spec_pilar_actividad", "label": "Actividad pillar (10%)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unmeasurable with Places data (reply rate, last activity) so excluded and weights rescaled."}, {"id": "specs_007_themora_digital_score_spec_bayesian_adjusted_rating", "label": "Bayesian-adjusted rating (m=10, prior C)", "file_type": "rationale", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pulls ratings with few reviews toward the reference average so a single 5-star review is not proof of an excellent reputation."}, {"id": "specs_007_themora_digital_score_spec_reference_rating", "label": "Reference rating C (competitor average or fixed 4.7)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Competitor average when >=3 rated, otherwise fixed 4.7; the group and its size are always disclosed."}, {"id": "specs_007_themora_digital_score_spec_health_bands", "label": "TDS health bands (Invisible/Vulnerable/Saludable/Fuerte/Dominante)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_007_themora_digital_score_spec_unmeasurable_data_rule", "label": "Unknown data never becomes zero (Evaluacion parcial)", "file_type": "rationale", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From TDS.docx honesty rules: unmeasurable items are excluded with rescaled weights and flagged \"No lo pudimos comprobar\"."}, {"id": "specs_007_themora_digital_score_spec_reality_multiplier", "label": "Reality multiplier (0 not found / 1 found)", "file_type": "concept", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The not-claimed=0.5 case from the .py is dropped because claim status is unobservable."}, {"id": "specs_007_themora_digital_score_spec_no_pay_for_points", "label": "Buying Themora services never grants points", "file_type": "rationale", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "specs_007_themora_digital_score_spec_tds_methodology_py", "label": "TDS methodology script (deepseek_python_20260922_aa6acf.py)", "file_type": "document", "source_file": "specs/007-themora-digital-score/spec.md", "source_location": null, "source_url": null, "capture